<?xml version="1.0"?>
<!-- Six-DOF revolute arm (load with "fixed base"). -->
<robot name="six_dof_arm">
  <material name="grey"><color rgba="0.55 0.57 0.60 1"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="5.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.1" length="0.1"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.1" length="0.1"/></geometry></collision>
  </link>

  <link name="shoulder_link">
    <inertial><origin xyz="0 0 0.08"/><mass value="2.0"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/></inertial>
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.06" length="0.16"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.06" length="0.16"/></geometry></collision>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="80" velocity="2.0"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="upper_arm_link">
    <inertial><origin xyz="0 0 0.175"/><mass value="2.0"/>
      <inertia ixx="0.022" ixy="0" ixz="0" iyy="0.022" iyz="0" izz="0.002"/></inertial>
    <visual><origin xyz="0 0 0.175"/><geometry><box size="0.08 0.08 0.35"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.175"/><geometry><box size="0.08 0.08 0.35"/></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.16"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="80" velocity="2.0"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="forearm_link">
    <inertial><origin xyz="0 0 0.15"/><mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.30"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.30"/></geometry></collision>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 0 0.35"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="40" velocity="2.5"/>
    <dynamics damping="0.3"/>
  </joint>

  <link name="wrist_1_link">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0004"/></inertial>
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.035" length="0.08"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.035" length="0.08"/></geometry></collision>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0 0 0.30"/><axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="15" velocity="3.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="wrist_2_link">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.4"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0003"/></inertial>
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.06 0.06 0.08"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><box size="0.06 0.06 0.08"/></geometry></collision>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="15" velocity="3.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <link name="wrist_3_link">
    <inertial><origin xyz="0 0 0.02"/><mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
  </link>
  <joint name="joint6" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="4.0"/>
    <dynamics damping="0.05"/>
  </joint>

  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_3_link"/><child link="tool0"/>
    <origin xyz="0 0 0.04"/>
  </joint>
</robot>
