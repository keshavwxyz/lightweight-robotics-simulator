<?xml version="1.0"?>
<!-- Robot with multiple visual meshes per link. Mixes package://, relative and primitive geometry. -->
<robot name="mesh_robot">
  <material name="steel"><color rgba="0.6 0.62 0.66 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="3.0"/>
      <inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.045"/></inertial>
    <visual name="base_body">
      <origin xyz="0 0 0.05"/>
      <geometry><mesh filename="package://mesh_robot_description/meshes/base.stl"/></geometry>
      <material name="steel"/>
    </visual>
    <visual name="knob_front">
      <origin xyz="0.12 0.12 0.1"/>
      <geometry><mesh filename="../meshes/knob.stl"/></geometry>
      <material name="red"/>
    </visual>
    <visual name="knob_back">
      <origin xyz="-0.12 -0.12 0.1"/>
      <geometry><mesh filename="../meshes/knob.stl" scale="0.5 0.5 0.5"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><mesh filename="package://mesh_robot_description/meshes/base.stl"/></geometry>
    </collision>
  </link>

  <link name="arm_link">
    <inertial><origin xyz="0 0 0.15"/><mass value="0.5"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0004"/></inertial>
    <visual>
      <geometry><mesh filename="package://mesh_robot_description/meshes/arm.obj"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.3"/>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mesh_robot_description/meshes/arm.obj"/></geometry>
    </collision>
  </link>
  <joint name="arm_joint" type="revolute">
    <parent link="base_link"/><child link="arm_link"/>
    <origin xyz="0 0 0.1"/><axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="20" velocity="2.0"/>
  </joint>
</robot>
